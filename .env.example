MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=219labs
MONGODB_LEADS_COLLECTION=leads
MONGODB_EMAIL_TEMPLATES_COLLECTION=emailMarketingTemplates
MONGODB_EMAIL_SENDS_COLLECTION=emailMarketingSends

# Google admin login
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ADMIN_SESSION_SECRET=change-this-long-random-secret-with-at-least-32-chars

# Google Analytics 4 server credentials
# Admin access is hard-locked in code to jcanepa.web@gmail.com.
GA_PROPERTY_ID=123456789
GA_CLIENT_EMAIL=analytics-reader@your-project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional. GA4 currently uses keyEvents for configured conversions.
GA_CONVERSION_METRIC=keyEvents

# Email marketing SMTP
EMAIL_MARKETING_HOST=smtp.gmail.com
EMAIL_MARKETING_PORT=587
EMAIL_MARKETING_USER=your-sender@gmail.com
EMAIL_MARKETING_PASS=your-app-password
EMAIL_MARKETING_FROM="219Labs <your-sender@gmail.com>"
EMAILMKT_CONCURRENCY=3

# Optional. Leave empty in production if the API lives in this same Vercel project.
VITE_LEADS_API_URL=
